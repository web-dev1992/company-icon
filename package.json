{
  "name": "company-icons",
  "version": "1.0.0",
  "description": "SVG-based React icon components",
  "keywords": [
    "React",
    "SVG",
    "Icons"
  ],
  "author": "Taraneh Mohebi",
  "license": "ISC",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "default": "./dist/index.esm.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "svgr": "svgr --icon --title-prop --replace-attr-values '#1D1D1D=currentColor' -d src assets",
    "prebuild": "rimraf src && rimraf dist",
    "build": "npm run svgr && rollup -c",
    "prepublishOnly": "npm run build",
    "docs": "npm run build && vite --config docs/vite.config.js",
    "docs:dev": "vite --config docs/vite.config.js",
    "docs:build": "npm run build && vite build --config docs/vite.config.js"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.10"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@svgr/cli": "^8.1.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.64.5",
    "rollup-plugin-filesize": "^10.0.0",
    "vite": "^8.3.4"
  }
}
